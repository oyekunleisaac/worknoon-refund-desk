# Copy to .env (docker compose reads it automatically).

# AI provider: set ONE key. Leave both empty to run with the keyword fallback.
# LLM_PROVIDER: auto (whichever key is set) | anthropic | openai
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Token for the support dashboard (/admin).
ADMIN_TOKEN=worknoon-admin

# Host port for the web app.
WEB_PORT=8080
